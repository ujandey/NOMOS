# Optional. Leave unset for the fully offline experience.
NOMOS_LLM_API_KEY=
NOMOS_LLM_MODEL=
NOMOS_LLM_ENDPOINT=https://api.openai.com/v1/chat/completions
# Port for npm start
PORT=4173
# Public demos: disable the paid endpoint entirely (or deploy `npm run build:static` to a static host).
NOMOS_PUBLIC_DEMO=
# Required to enable the model parser when NOMOS_HOST is not loopback. Rate limits are cost controls, not authentication.
NOMOS_LLM_ALLOW_REMOTE=
NOMOS_LLM_RATE_PER_MINUTE=6
NOMOS_LLM_DAILY_LIMIT=200
NOMOS_LLM_MAX_CONCURRENT=2
# Trust X-Forwarded-For for per-client limits only behind a reverse proxy you control.
NOMOS_TRUST_PROXY=
